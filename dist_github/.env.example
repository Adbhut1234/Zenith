LIVEKIT_URL=wss://your-livekit-server-url
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

GOOGLE_API_KEY=your_google_api_key
GEMINI_LIVE_MODEL=gemini-3.8-live

# Long-term memory is 100% local and offline (SQLite + Hybrid Vector RAG in zenith_memory.db)
# No third-party memory API keys required!

GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# Identity
Zenith_USER_ID=Admin

# Security Configurations
REQUIRE_CMD_CONFIRMATION=true
ALLOWED_COMMANDS=start calc,start notepad,start msedge,explorer
